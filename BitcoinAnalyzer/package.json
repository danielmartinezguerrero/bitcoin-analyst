{
  "name": "bitcoin-analyzer",
  "version": "1.0.0",
  "description": "Educational Bitcoin market analysis - technical, structural and derivatives data",
  "main": "app/main.js",
  "author": "Daniel Marti Guerrero",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.dmg.bitcoinanalyzer",
    "productName": "Bitcoin Analyzer",
    "files": [
      "app/**/*",
      "core/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "BitcoinAnalyzer.exe"
    }
  }
}
